// ===== QUIZ : DÉMARRAGE =====
void EducationalMode::startQuiz() {
    quizActive = true;
    currentQuestionIndex = 0;
    score = 0;
    totalAnswered = 0;
    answerRevealed = false;
    selectedAnswer = -1;
    
    // Mélanger les questions
    std::random_shuffle(quizQuestions.begin(), quizQuestions.end());
}

// ===== QUIZ : QUESTION SUIVANTE =====
void EducationalMode::nextQuestion() {
    if (currentQuestionIndex < static_cast<int>(quizQuestions.size()) - 1) {
        currentQuestionIndex++;
  answerRevealed = false;
        selectedAnswer = -1;
        feedbackTimer = 0.f;
    } else {
        // Fin du quiz
        quizActive = false;
    }
}

// ===== QUIZ : RÉPONDRE =====
void EducationalMode::answerQuestion(int choiceIndex) {
    if (answerRevealed) return;
    
    selectedAnswer = choiceIndex;
    answerRevealed = true;
    totalAnswered++;
    
    if (choiceIndex == quizQuestions[currentQuestionIndex].correctAnswer) {
        score++;
    }
    
    feedbackTimer = 0.f;
}

// ===== QUIZ : GESTION DES CLICS =====
bool EducationalMode::handleQuizClick(const sf::Vector2f& mousePos) {
    if (!quizActive || answerRevealed) return false;
    
    float choiceY = 350.f;
    float choiceH = 50.f;
    float spacing = 10.f;
    
    for (int i = 0; i < 4; ++i) {
        sf::FloatRect choiceBounds(250.f, choiceY + i * (choiceH + spacing), 700.f, choiceH);
        if (choiceBounds.contains(mousePos)) {
            answerQuestion(i);
      return true;
        }
    }
    
    // Bouton "Question Suivante"
    if (answerRevealed) {
        sf::FloatRect nextBtnBounds(500.f, 680.f, 200.f, 50.f);
        if (nextBtnBounds.contains(mousePos)) {
     nextQuestion();
   return true;
        }
    }
    
    return false;
}

// ===== QUIZ : DESSIN =====
void EducationalMode::drawQuiz(sf::RenderWindow& window) {
    if (!quizActive || currentQuestionIndex >= static_cast<int>(quizQuestions.size())) return;
    
// Fond semi-transparent
    sf::RectangleShape overlay(sf::Vector2f(1200.f, 800.f));
    overlay.setFillColor(sf::Color(0, 0, 0, 200));
    window.draw(overlay);
    
    // Panneau principal
    sf::RectangleShape panel(sf::Vector2f(900.f, 700.f));
    panel.setPosition(150.f, 50.f);
    panel.setFillColor(sf::Color(20, 30, 50, 240));
    panel.setOutlineThickness(4.f);
    panel.setOutlineColor(sf::Color(100, 180, 255));
    window.draw(panel);
    
    // En-tête
    sf::RectangleShape header(sf::Vector2f(900.f, 80.f));
    header.setPosition(150.f, 50.f);
    header.setFillColor(sf::Color(50, 100, 180, 220));
    window.draw(header);
    
    // Titre
    sf::Text title("QUIZ ASTRONOMIQUE", font, 32);
    title.setPosition(600.f, 70.f);
    title.setOrigin(title.getLocalBounds().width / 2.f, 0.f);
    title.setFillColor(sf::Color::White);
    title.setStyle(sf::Text::Bold);
    window.draw(title);
    
    drawQuizStats(window);
    drawQuizQuestion(window);
    drawQuizChoices(window);
    
    if (answerRevealed) {
        drawQuizFeedback(window);
    }
}

// ===== QUIZ : QUESTION =====
void EducationalMode::drawQuizQuestion(sf::RenderWindow& window) {
    const auto& q = quizQuestions[currentQuestionIndex];
    
 // Numéro de question
    std::ostringstream oss;
    oss << "Question " << (currentQuestionIndex + 1) << " / " << quizQuestions.size();
    sf::Text questionNum(oss.str(), font, 18);
    questionNum.setPosition(200.f, 150.f);
    questionNum.setFillColor(sf::Color(150, 200, 255));
    window.draw(questionNum);
    
    // Texte de la question
    sf::Text questionText(q.question, font, 24);
    questionText.setPosition(600.f, 220.f);
    questionText.setOrigin(questionText.getLocalBounds().width / 2.f, 0.f);
    questionText.setFillColor(sf::Color::White);
    questionText.setStyle(sf::Text::Bold);
    window.draw(questionText);
}

// ===== QUIZ : CHOIX =====
void EducationalMode::drawQuizChoices(sf::RenderWindow& window) {
    const auto& q = quizQuestions[currentQuestionIndex];
    
    float choiceY = 300.f;
    float choiceH = 60.f;
  float spacing = 15.f;
    
    for (int i = 0; i < 4; ++i) {
    sf::RectangleShape choiceBox(sf::Vector2f(700.f, choiceH));
        choiceBox.setPosition(250.f, choiceY);
 
     // Couleur selon l'état
        if (answerRevealed) {
            if (i == q.correctAnswer) {
     choiceBox.setFillColor(sf::Color(50, 180, 50, 220));  // Vert
          choiceBox.setOutlineColor(sf::Color(0, 255, 0));
            } else if (i == selectedAnswer) {
   choiceBox.setFillColor(sf::Color(180, 50, 50, 220));  // Rouge
                choiceBox.setOutlineColor(sf::Color(255, 0, 0));
  } else {
        choiceBox.setFillColor(sf::Color(40, 50, 70, 200));
     choiceBox.setOutlineColor(sf::Color(80, 100, 130));
            }
        } else {
 choiceBox.setFillColor(sf::Color(40, 60, 90, 220));
  choiceBox.setOutlineColor(sf::Color(100, 150, 200));
        }
        
        choiceBox.setOutlineThickness(3.f);
 window.draw(choiceBox);
        
        // Lettre (A, B, C, D)
      sf::Text letter(std::string(1, 'A' + i), font, 24);
        letter.setPosition(270.f, choiceY + 18.f);
    letter.setFillColor(sf::Color::White);
        letter.setStyle(sf::Text::Bold);
        window.draw(letter);
        
        // Texte du choix
        sf::Text choiceText(q.choices[i], font, 18);
choiceText.setPosition(320.f, choiceY + 20.f);
        choiceText.setFillColor(sf::Color::White);
        window.draw(choiceText);
        
        choiceY += choiceH + spacing;
    }
}

// ===== QUIZ : FEEDBACK =====
void EducationalMode::drawQuizFeedback(sf::RenderWindow& window) {
    const auto& q = quizQuestions[currentQuestionIndex];
    bool correct = (selectedAnswer == q.correctAnswer);
    
    // Panneau d'explication
    sf::RectangleShape explPanel(sf::Vector2f(700.f, 120.f));
    explPanel.setPosition(250.f, 540.f);
    explPanel.setFillColor(sf::Color(30, 40, 60, 230));
    explPanel.setOutlineThickness(2.f);
    explPanel.setOutlineColor(correct ? sf::Color(0, 255, 0) : sf::Color(255, 100, 100));
    window.draw(explPanel);
    
    // Résultat
    sf::Text result(correct ? "CORRECT !" : "INCORRECT", font, 22);
    result.setPosition(600.f, 550.f);
    result.setOrigin(result.getLocalBounds().width / 2.f, 0.f);
    result.setFillColor(correct ? sf::Color(0, 255, 0) : sf::Color(255, 100, 100));
    result.setStyle(sf::Text::Bold);
    window.draw(result);
    
    // Explication
    sf::Text expl(q.explanation, font, 14);
    expl.setPosition(280.f, 590.f);
    expl.setFillColor(sf::Color(200, 220, 255));
    window.draw(expl);
    
    // Bouton "Question Suivante"
    sf::RectangleShape nextBtn(sf::Vector2f(200.f, 50.f));
  nextBtn.setPosition(500.f, 680.f);
 nextBtn.setFillColor(sf::Color(50, 150, 255));
    nextBtn.setOutlineThickness(2.f);
    nextBtn.setOutlineColor(sf::Color::White);
    window.draw(nextBtn);
    
    sf::Text nextText("SUIVANT", font, 20);
    nextText.setPosition(600.f, 692.f);
    nextText.setOrigin(nextText.getLocalBounds().width / 2.f, 0.f);
    nextText.setFillColor(sf::Color::White);
    nextText.setStyle(sf::Text::Bold);
    window.draw(nextText);
}

// ===== QUIZ : STATISTIQUES =====
void EducationalMode::drawQuizStats(sf::RenderWindow& window) {
    std::ostringstream oss;
    oss << "Score: " << score << " / " << totalAnswered;
 
    sf::Text stats(oss.str(), font, 18);
    stats.setPosition(900.f, 150.f);
    stats.setFillColor(sf::Color(255, 255, 100));
    stats.setStyle(sf::Text::Bold);
    window.draw(stats);
    
    if (totalAnswered > 0) {
        oss.str("");
        oss << "Precision: " << std::fixed << std::setprecision(0) 
            << (getAccuracy() * 100.f) << "%";
      sf::Text accuracy(oss.str(), font, 16);
        accuracy.setPosition(900.f, 175.f);
        accuracy.setFillColor(sf::Color(150, 200, 255));
        window.draw(accuracy);
    }
}

// ===== CARTES : AFFICHER LA SUIVANTE =====
void EducationalMode::showNextCard() {
    currentCardIndex = (currentCardIndex + 1) % learningCards.size();
    cardTimer = 0.f;
}

// ===== CARTES : DESSIN =====
void EducationalMode::drawLearningCard(sf::RenderWindow& window, float time) {
    if (!cardActive || learningCards.empty()) return;
    
    const auto& card = learningCards[currentCardIndex];
    
    // Animation de pulsation
    float pulse = 1.f + 0.05f * std::sin(time * 2.f);
    
    // Panneau de la carte
    sf::RectangleShape cardPanel(sf::Vector2f(500.f * pulse, 300.f * pulse));
    cardPanel.setPosition(350.f, 250.f);
  cardPanel.setOrigin(250.f * pulse, 150.f * pulse);
    cardPanel.setFillColor(sf::Color(20, 30, 50, 240));
    cardPanel.setOutlineThickness(4.f);
    cardPanel.setOutlineColor(card.accentColor);
    window.draw(cardPanel);
    
  // Barre supérieure
    sf::RectangleShape topBar(sf::Vector2f(500.f, 50.f));
    topBar.setPosition(100.f, 100.f);
    topBar.setFillColor(card.accentColor);
    window.draw(topBar);
    
    // Catégorie
    sf::Text category(card.category, font, 16);
    category.setPosition(120.f, 115.f);
    category.setFillColor(sf::Color::White);
    category.setStyle(sf::Text::Bold);
    window.draw(category);
    
    // Titre
 sf::Text title(card.title, font, 22);
    title.setPosition(350.f, 170.f);
    title.setOrigin(title.getLocalBounds().width / 2.f, 0.f);
title.setFillColor(card.accentColor);
  title.setStyle(sf::Text::Bold);
    window.draw(title);
    
    // Fait (avec retour à la ligne automatique)
    // TODO: Implémenter le word wrap si nécessaire
    sf::Text fact(card.fact, font, 14);
    fact.setPosition(120.f, 220.f);
    fact.setFillColor(sf::Color(200, 220, 255));
    window.draw(fact);
}

// ===== PRÉCISION =====
float EducationalMode::getAccuracy() const {
    if (totalAnswered == 0) return 0.f;
    return static_cast<float>(score) / static_cast<float>(totalAnswered);
}
