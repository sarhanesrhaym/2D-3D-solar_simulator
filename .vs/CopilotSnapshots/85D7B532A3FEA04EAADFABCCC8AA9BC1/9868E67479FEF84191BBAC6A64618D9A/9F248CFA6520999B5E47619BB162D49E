// ===== CODE D'IMPLÉMENTATION =====
// À insérer dans drawSimulation() en remplaçant la section du panneau flottant

// ===== PANNEAU D'INFORMATION HEXAGONALE RÉVOLUTIONNAIRE =====
if (cameraFollowMode && followedPlanetIndex >= 0 &&
    followedPlanetIndex < static_cast<int>(planets.size())) {

    const auto& planet = planets[followedPlanetIndex];
    sf::Vector2f planetPos = planet.shape.getPosition();
    float planetRadius = planet.shape.getRadius();

    // Calculs en temps réel
    float distToSun = std::hypot(planetPos.x - Constants::SUN_CENTER.x,
        planetPos.y - Constants::SUN_CENTER.y);
    float speed = std::hypot(planet.velocity.x, planet.velocity.y);
    float angleRad = std::atan2(planetPos.y - Constants::SUN_CENTER.y,
        planetPos.x - Constants::SUN_CENTER.x);
    float angleDeg = angleRad * 180.f / 3.14159f;
    if (angleDeg < 0) angleDeg += 360.f;

  // ===== CERCLE DE SUIVI ANIMÉ (INCHANGÉ) =====
    float pulseScale = 1.0f + 0.25f * std::sin(time * 5.f);
    float indicatorRadius = (planetRadius + 25.f) * pulseScale;

    sf::CircleShape followCircle(indicatorRadius);
    followCircle.setOrigin(indicatorRadius, indicatorRadius);
    followCircle.setPosition(planetPos);
    followCircle.setFillColor(sf::Color::Transparent);
    followCircle.setOutlineThickness(4.f);
    followCircle.setOutlineColor(sf::Color(0, 255, 100, 255));
 window.draw(followCircle);

    for (int i = 0; i < 4; ++i) {
    float angle = (i * 90.f + time * 60.f) * 3.14159f / 180.f;
        float arrowDist = indicatorRadius + 15.f;

        sf::ConvexShape arrow;
     arrow.setPointCount(3);
  arrow.setPoint(0, sf::Vector2f(0, -10));
    arrow.setPoint(1, sf::Vector2f(-7, 10));
  arrow.setPoint(2, sf::Vector2f(7, 10));
  arrow.setPosition(planetPos.x + arrowDist * std::cos(angle),
         planetPos.y + arrowDist * std::sin(angle));
        arrow.setRotation(angle * 180.f / 3.14159f + 90.f);
        arrow.setFillColor(sf::Color(0, 255, 100, 255));
        window.draw(arrow);
    }

    // ===== PANNEAU HEXAGONAL RÉVOLUTIONNAIRE =====
    float panelW = 400.f;  // Largeur hexagone
    float panelH = 280.f;  // Hauteur hexagone
    float panelOffsetX = planetRadius + 100.f;
    sf::Vector2f panelPos(planetPos.x + panelOffsetX, planetPos.y - panelH / 2.f);

    // ===== EFFET AURORA - LUEUR ANIMÉE EN ARRIÈRE-PLAN =====
    float auroraRotation = time * 15.f; // Rotation lente
    for (int layer = 3; layer >= 0; --layer) {
        sf::CircleShape aurora(panelW * (1.f + layer * 0.3f));
        aurora.setOrigin(panelW * (1.f + layer * 0.3f), panelW * (1.f + layer * 0.3f));
      aurora.setPosition(panelPos.x + panelW / 2.f, panelPos.y + panelH / 2.f);
        
     float alphaVal = 20 - layer * 5;
        aurora.setFillColor(sf::Color(
            planet.color.r, planet.color.g, planet.color.b,
            static_cast<sf::Uint8>(alphaVal + 10 * std::sin(time * 2.f + layer))
  ));
        window.draw(aurora);
    }

    // ===== FORME HEXAGONALE - CORPS PRINCIPAL =====
    // Créer un hexagone avec coins arrondis (approximé avec un ConvexShape)
 sf::ConvexShape hexagon;
    hexagon.setPointCount(6);
    
    float hexRadius = panelW / 2.f;
    for (int i = 0; i < 6; ++i) {
        float angle = (i * 60.f - 30.f) * 3.14159f / 180.f; // -30° pour pointu en haut
        float x = hexRadius * std::cos(angle);
        float y = hexRadius * std::sin(angle);
hexagon.setPoint(i, sf::Vector2f(x, y));
    }
    
    hexagon.setOrigin(panelW / 2.f, panelH / 2.f);
    hexagon.setPosition(panelPos.x + panelW / 2.f, panelPos.y + panelH / 2.f);
  
    // Dégradé de remplissage
    hexagon.setFillColor(sf::Color(8, 20, 50, 245));
    hexagon.setOutlineThickness(3.f);
    hexagon.setOutlineColor(planet.color);
    window.draw(hexagon);

    // ===== LIGNE DE CONNEXION ANIMÉE =====
    sf::VertexArray connector(sf::LineStrip, 5);
    for (int i = 0; i < 5; ++i) {
    float t = i / 4.f;
        float waveOffset = 10.f * std::sin(time * 3.f + i);
 
      float x = planetPos.x + planetRadius + 5.f + t * (panelPos.x - planetPos.x - planetRadius - 5.f);
        float y = planetPos.y + waveOffset;
 
        connector[i].position = sf::Vector2f(x, y);
        connector[i].color = sf::Color(planet.color.r, planet.color.g, planet.color.b,
            static_cast<sf::Uint8>(200 - i * 40));
 }
    window.draw(connector);

    // ===== SECTION 1 : EN-TÊTE TOURNANT =====
    float headerRotation = time * 10.f; // Rotation lente
    
    // Rectangle pour la barre supérieure
    sf::RectangleShape headerBar(sf::Vector2f(panelW - 10.f, 50.f));
    headerBar.setPosition(panelPos.x + 5.f, panelPos.y + 10.f);
    headerBar.setFillColor(sf::Color(planet.color.r, planet.color.g, planet.color.b,
        static_cast<sf::Uint8>(100 + 50 * std::sin(time * 2.f))));
    window.draw(headerBar);

    // Nom de la planète - STYLE MODERNE
    sf::Text planetName(planet.name, font, 24);
    planetName.setPosition(panelPos.x + panelW / 2.f, panelPos.y + 15.f);
    planetName.setOrigin(planetName.getLocalBounds().width / 2.f, 0.f);
    planetName.setFillColor(sf::Color::White);
    planetName.setStyle(sf::Text::Bold);
    window.draw(planetName);

    // Type avec icône
    sf::Text planetType(planet.planetType, font, 11);
    planetType.setPosition(panelPos.x + panelW / 2.f, panelPos.y + 35.f);
    planetType.setOrigin(planetType.getLocalBounds().width / 2.f, 0.f);
  planetType.setFillColor(sf::Color(200, 220, 255));
    planetType.setStyle(sf::Text::Italic);
  window.draw(planetType);

    // ===== SECTION 2 : MINI ORBITE CENTRALE =====
  float miniOrbiteX = panelPos.x + panelW / 2.f;
    float miniOrbiteY = panelPos.y + panelH / 2.f - 20.f;
    
    // Cercle pulsant pour l'orbite
    float pulseMini = 1.f + 0.15f * std::sin(time * 3.f);
    
    sf::CircleShape orbitPathMini(30.f * pulseMini);
    orbitPathMini.setOrigin(30.f * pulseMini, 30.f * pulseMini);
    orbitPathMini.setPosition(miniOrbiteX, miniOrbiteY);
    orbitPathMini.setFillColor(sf::Color::Transparent);
    orbitPathMini.setOutlineThickness(2.f);
    orbitPathMini.setOutlineColor(sf::Color(planet.color.r, planet.color.g, planet.color.b,
        static_cast<sf::Uint8>(150 * pulseMini)));
    window.draw(orbitPathMini);

    // Soleil au centre
    sf::CircleShape miniSun(4.f);
    miniSun.setOrigin(4.f, 4.f);
    miniSun.setPosition(miniOrbiteX, miniOrbiteY);
    miniSun.setFillColor(sf::Color(255, 200, 50));
    miniSun.setOutlineThickness(1.f);
    miniSun.setOutlineColor(sf::Color(255, 255, 200));
    window.draw(miniSun);

    // Planète en orbite avec traînée
    float miniPlanetX = miniOrbiteX + 30.f * std::cos(angleRad);
    float miniPlanetY = miniOrbiteY + 30.f * std::sin(angleRad);
    
    sf::CircleShape miniPlanet(5.f);
    miniPlanet.setOrigin(5.f, 5.f);
    miniPlanet.setPosition(miniPlanetX, miniPlanetY);
    miniPlanet.setFillColor(planet.color);
    miniPlanet.setOutlineThickness(2.f);
    miniPlanet.setOutlineColor(sf::Color::White);
    window.draw(miniPlanet);

    // ===== SECTION 3 : GRILLE D'INFORMATIONS (3x2) =====
    float infoStartX = panelPos.x + 15.f;
    float infoStartY = panelPos.y + 120.f;
    float colWidth = (panelW - 30.f) / 2.f;
    float rowHeight = 50.f;

    // Données à afficher avec icônes et couleurs
    struct InfoData {
        std::string icon;
        std::string label;
        std::string value;
        sf::Color color;
    };

    std::vector<InfoData> infos = {
   {"??", "Distance", 
         std::to_string(static_cast<int>(distToSun)) + " UA",
         sf::Color(255, 200, 100)},
   
        {"??", "Orbite",
 std::to_string(static_cast<int>(planet.semiMajorAxis)) + " u",
       sf::Color(150, 255, 150)},
        
        {"??", "Vitesse",
         std::to_string(static_cast<int>(speed * 100) / 100.f) + " u/s",
       (speed > 1.5f ? sf::Color(255, 80, 80) : 
          speed > 0.8f ? sf::Color(255, 200, 0) : 
          sf::Color(100, 255, 100))},
        
        {"??", "Excentricité",
         std::to_string(static_cast<int>(planet.eccentricity * 1000) / 1000.f),
         sf::Color(255, 180, 100)},
        
    {"??", "Position",
         std::to_string(static_cast<int>(angleDeg)) + "°",
         sf::Color(100, 220, 255)},
        
        {"??", "Masse",
       std::to_string(static_cast<int>(planet.mass * 10) / 10.f),
         sf::Color(255, 150, 150)}
    };

    // Afficher les 6 informations en grille 3x2
    for (size_t i = 0; i < infos.size(); ++i) {
        float row = i / 2;
        float col = i % 2;
   
        float cellX = infoStartX + col * (colWidth + 5.f);
     float cellY = infoStartY + row * rowHeight;

        // Fond de la cellule avec bordure
        sf::RectangleShape cellBg(sf::Vector2f(colWidth - 5.f, 45.f));
        cellBg.setPosition(cellX, cellY);
    cellBg.setFillColor(sf::Color(20, 40, 70, 180));
        cellBg.setOutlineThickness(1.f);
        cellBg.setOutlineColor(infos[i].color);
     window.draw(cellBg);

      // Icône
        sf::Text iconText(infos[i].icon, font, 16);
        iconText.setPosition(cellX + 5.f, cellY + 5.f);
        iconText.setFillColor(infos[i].color);
        window.draw(iconText);

     // Label
        sf::Text labelText(infos[i].label, font, 10);
  labelText.setPosition(cellX + 25.f, cellY + 5.f);
        labelText.setFillColor(sf::Color(180, 200, 220));
        window.draw(labelText);

        // Valeur
        sf::Text valueText(infos[i].value, font, 13);
    valueText.setPosition(cellX + 25.f, cellY + 20.f);
        valueText.setFillColor(infos[i].color);
   valueText.setStyle(sf::Text::Bold);
        window.draw(valueText);

        // Effet pulsant sur la cellule
        float cellPulse = 0.5f + 0.5f * std::sin(time * 2.f + i);
        sf::RectangleShape cellHighlight(sf::Vector2f(colWidth - 5.f, 45.f));
        cellHighlight.setPosition(cellX, cellY);
        cellHighlight.setFillColor(sf::Color(infos[i].color.r, infos[i].color.g, 
            infos[i].color.b, static_cast<sf::Uint8>(10 * cellPulse)));
   window.draw(cellHighlight);
    }

  // ===== SECTION 4 : LIGNE SÉPARATRICE ANIMÉE =====
    sf::RectangleShape separator(sf::Vector2f(panelW - 30.f, 2.f));
    separator.setPosition(panelPos.x + 15.f, panelPos.y + panelH - 25.f);
    float sepAlpha = 100 + 50 * std::sin(time * 3.f);
    separator.setFillColor(sf::Color(planet.color.r, planet.color.g, planet.color.b,
        static_cast<sf::Uint8>(sepAlpha)));
    window.draw(separator);

    // ===== SECTION 5 : PIED DE PAGE - INFO SUPPLÉMENTAIRE =====
    sf::Text footerText(std::string("Satellites: ") + std::to_string(planet.numMoons), font, 10);
    footerText.setPosition(panelPos.x + panelW / 2.f, panelPos.y + panelH - 15.f);
    footerText.setOrigin(footerText.getLocalBounds().width / 2.f, 0.f);
footerText.setFillColor(sf::Color(200, 220, 255));
    window.draw(footerText);
}

