    nebula1.setPosition(100.f - parallax.x * 0.5f, 50.f - parallax.y * 0.5f);
    float alpha1 = 20.f + 15.f * std::sin(nebulaPhase);
    nebula1.setFillColor(sf::Color(20, 50, 100,
        static_cast<sf::Uint8>(std::max(0.f, std::min(255.f, alpha1)))));
